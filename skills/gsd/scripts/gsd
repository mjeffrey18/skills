# Project review rules


RULES_REL = ".agents/rules/review/REVIEW.md"
RULES_INDEX_REL = ".agents/rules/review/index.md"
RULES_KEYS = (
    "updated",
    "version",
    "risk_paths",
    "always_high",
    "review_focus",
    "known_landmines",
    "settled",
    "nitpick_cap",
    "rollback",
)
RULE_CLASSES = (
    "auth",
    "injection",
    "secrets",
    "data-exposure",
    "input-validation",
    "error-handling",
    "race",
    "idempotency",
    "migration",
    "resource-leak",
    "edge-case",
    "spec-gap",
    "test-gap",
    "convention",
    "docs",
    "other",
)
PROTECTED_CLASSES = ("race", "idempotency", "migration", "auth", "injection", "secrets", "data-exposure")
UNLISTED_TIER = 1
RULES_MIGRATION = (
    "to migrate, rename the legacy file and update its index.md row or references, then create the "
    "project review rules from the gsd template (templates/PROJECT-REVIEW.md)"
)
FIELD_SPLIT_RE = re.compile(r"\s+\|\s+")


def rule_fields(entry):
    return [part.strip() for part in FIELD_SPLIT_RE.split(entry.strip())]


def glob_regex(pattern):
    """A path glob: `**` crosses folders, `*` and `?` stay inside one."""
    out, i = [], 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out.append("(?:.*/)?")
            i += 3
        elif pattern.startswith("**", i):
            out.append(".*")
            i += 2
        elif pattern[i] == "*":
            out.append("[^/]*")
            i += 1
        elif pattern[i] == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(pattern[i]))
            i += 1
    # DOTALL: git hands over file names with embedded newlines intact, and `**` must still cover them.
    return re.compile("".join(out) + r"\Z", re.DOTALL)


def glob_matches(pattern, path):
    return bool(glob_regex(pattern.strip().lstrip("/")).match(path))


def index_lists(text, name):
    """Whether a repo-lens index.md table has a row whose File cell is `name`."""
    file_column = None
    for line in (text or "").splitlines():
        stripped = line.strip()
        if not stripped.startswith("|"):
            file_column = None
            continue
        cells = [cell.strip() for cell in stripped.strip("|").split("|")]
        if all(re.fullmatch(r":?-+:?", cell) for cell in cells if cell):
            continue
        if file_column is None and "File" in cells:
            file_column = cells.index("File")
            continue
        candidates = [cells[file_column]] if file_column is not None and file_column < len(cells) else cells
        for cell in candidates:
            target = re.sub(r"^\[[^\]]*\]\(([^)]+)\)$", r"\1", cell).strip("`").strip()
            if target and os.path.normpath(target) == name:
                return True
    return False


def legacy_uses(meta, index_text):
    """The legacy roles a REVIEW.md in .agents/rules/review/ already has; any one keeps it out of the rules."""
    uses = []
    if "mode" in meta:
        uses.append("GSD stage agent (its front matter has mode)")
    if index_lists(index_text, "REVIEW.md"):
        uses.append("review-critic repo lens (index.md lists it)")
    return uses


def collision_message(where, uses):
    return "%s%s is a %s, so it is not read as project review rules; %s" % (
        RULES_REL,
        where,
        " and a ".join(uses),
        RULES_MIGRATION,
    )


def read_rules(root, rev):
    """Return (rules text, index text) at `rev`, or from the working tree when `rev` is None."""
    texts = []
    for rel in (RULES_REL, RULES_INDEX_REL):
        if rev is None:
            path = os.path.join(root, rel)
            if os.path.isfile(path):
                with open(path, encoding="utf-8", errors="replace") as handle:
                    texts.append(handle.read())
            else:
                texts.append(None)
        else:
            code, out = git(root, "show", "%s:./%s" % (rev, rel))
            texts.append(out if code == 0 else None)
    return texts[0], texts[1]


def structured_rules(text):
    """Read only `risk_paths` and `always_high`; return (risk entries, always_high globs, problems)."""
    meta, _, _, _, _ = parse_front_matter(text)
    risk, problems = [], []
    for entry in as_list(meta.get("risk_paths")):
        fields = rule_fields(entry)
        if len(fields) != 2 or not fields[0] or fields[1] not in ("0", "1", "2"):
            problems.append('risk_paths entry %r is not "<glob> | <tier 0, 1 or 2>"; ignored' % entry)
            continue
        risk.append((fields[0], int(fields[1])))
    return risk, as_list(meta.get("always_high")), problems


def validate_rules(checkout):
    """Diagnostics for the project review rules file in `checkout`, or [] when it has none."""
    text, index_text = read_rules(checkout, None)
    if text is None:
        return []
    path = os.path.join(checkout, RULES_REL)
    meta, where, unsupported, found, _ = parse_front_matter(text)
    uses = legacy_uses(meta if found else {}, index_text)
    if uses:
        return [diag("rules-collision", "warning", path, collision_message("", uses))]
    if not found:
        return [diag("rules-front-matter", "error", path, "project review rules need front matter between --- lines")]
    out = [
        diag("rules-front-matter", "error", path, "unsupported front matter: %s" % line.strip(), number)
        for number, line in unsupported
    ]

    def bad(code, key, message):
        out.append(diag(code, "error", path, message, where.get(key)))

    for key in meta:
        if key not in RULES_KEYS:
            bad("rules-key", key, "unknown key %r (expected %s)" % (key, ", ".join(RULES_KEYS)))
    for entry in as_list(meta.get("risk_paths")):
        fields = rule_fields(entry)
        if len(fields) != 2 or not fields[0]:
            bad("rules-risk-path", "risk_paths", 'risk_paths entry %r is not "<glob> | <tier>"' % entry)
        elif fields[1] not in ("0", "1", "2"):
            bad("rules-tier", "risk_paths", "risk_paths entry %r has tier %r; expected 0, 1 or 2" % (entry, fields[1]))
    for key in ("always_high", "review_focus"):
        if isinstance(meta.get(key), str) and meta[key].strip():
            bad("rules-list", key, "%s must be a list" % key)
    for entry in as_list(meta.get("known_landmines")):
        fields = rule_fields(entry)
        if len(fields) != 3 or not all(fields):
            bad(
                "rules-landmine",
                "known_landmines",
                "known_landmines entry %r needs three fields: <glob> | <what bites> | <source>" % entry,
            )
    for entry in as_list(meta.get("settled")):
        fields = rule_fields(entry)
        if len(fields) != 6 or not all(fields):
            bad(
                "rules-settled",
                "settled",
                "settled entry %r needs six fields: <glob> | <symbol or *> | "
                "<rule class> | <rejected claim> | <lasting reason> | <source>" % entry,
            )
        elif fields[2] in PROTECTED_CLASSES:
            bad(
                "rules-settled-protected",
                "settled",
                "settled entry %r is in the protected class %r; protected findings are never settled"
                % (entry, fields[2]),
            )
        elif fields[2] not in RULE_CLASSES or fields[2] == "other":
            bad(
                "rules-settled-class",
                "settled",
                "settled entry %r has rule class %r; expected one of %s, never "
                "other" % (entry, fields[2], ", ".join(c for c in RULE_CLASSES if c != "other")),
            )
    cap = meta.get("nitpick_cap")
    if cap is not None and not (isinstance(cap, str) and re.fullmatch(r"\d+", cap)):
        bad("rules-cap", "nitpick_cap", "nitpick_cap %r is not a whole number" % (cap,))
    rollback = meta.get("rollback")
    if not isinstance(rollback, str) or not rollback.strip():
        bad("rules-rollback", "rollback", "rollback is missing; name how to undo a change in this repository")
    return out


def risk_rule_sets(root, base):
    """[(label, rev or None)]: HEAD (or the working tree outside Git), then the base when given."""
    sets: list[tuple[str, str | None]]
    if git(root, "rev-parse", "--verify", "--quiet", "HEAD^{commit}")[0] == 0:
        sets = [("HEAD", "HEAD")]
    elif base:
        raise UsageError("--base needs a Git checkout with commits")
    else:
        sets = [("working tree", None)]
    if base:
        code, sha = git(root, "rev-parse", "--verify", "--quiet", base + "^{commit}")
        if code != 0:
            raise UsageError("--base %r is not a commit" % base)
        sets.append(("base %s" % sha.strip()[:7], sha.strip()))
    return sets


def risk_floor(tier, high):
    if high or tier == 2:
        return "L3"
    return "L2" if tier == 1 else None


def changed_paths(root, base):
    """Paths changed between BASE and HEAD. --no-renames lists both sides of a move, so a file moved out of a
    protected glob still matches it; -z keeps names with spaces or quotes intact."""
    code, out = git(root, "diff", "--no-renames", "--name-only", "-z", base, "HEAD", "--")
    if code != 0:
        raise UsageError("cannot list the paths changed since %r" % base)
    return [p for p in out.split("\0") if p]


def cmd_risk(args, root):
    if args.changed and not args.base:
        raise UsageError("--changed needs --base")
    if not args.paths and not args.changed:
        raise UsageError("risk needs at least one PATH, or --base REV --changed")
    rules, notes, loaded = [], [], []
    sets = risk_rule_sets(root, args.base)
    raw_paths = list(args.paths)
    if args.changed:
        raw_paths += [p for p in changed_paths(root, sets[-1][1]) if p not in raw_paths]
    for label, rev in sets:
        text, index_text = read_rules(root, rev)
        entry: dict[str, Any] = {"rules": label, "state": "absent"}
        if text is not None:
            meta, _, _, found, _ = parse_front_matter(text)
            uses = legacy_uses(meta if found else {}, index_text)
            if uses:
                entry.update(state="collision", message=collision_message(" (%s)" % label, uses))
            else:
                risk, high, problems = structured_rules(text)
                entry.update(state="found", problems=problems)
                loaded.append((label, risk, high))
        if rev == "HEAD":
            working, _ = read_rules(root, None)
            if working != text:
                notes.append("the working tree's %s differs from HEAD; risk reads HEAD" % RULES_REL)
        rules.append(entry)
    paths = []
    for raw in raw_paths:
        path = os.path.relpath(os.path.abspath(raw), root) if os.path.isabs(raw) else os.path.normpath(raw)
        path = path.replace(os.sep, "/")
        report = {
            "path": path,
            "tier": None,
            "tier_sources": [],
            "always_high": False,
            "always_high_sources": [],
            "floor": None,
        }
        if loaded:
            tiers = []
            for label, risk, _ in loaded:
                hits = [(tier, glob) for glob, tier in risk if glob_matches(glob, path)]
                tier = max(t for t, _ in hits) if hits else UNLISTED_TIER
                tiers.append((tier, {"rules": label, "entry": next((g for t, g in hits if t == tier), None)}))
            report["tier"] = max(t for t, _ in tiers)
            report["tier_sources"] = [source for t, source in tiers if t == report["tier"]]
            report["always_high_sources"] = [
                {"rules": label, "glob": glob} for label, _, high in loaded for glob in high if glob_matches(glob, path)
            ]
            report["always_high"] = bool(report["always_high_sources"])
            report["floor"] = risk_floor(report["tier"], report["always_high"])
        paths.append(report)
    floors = [p["floor"] for p in paths if p["floor"]]
    floor = max(floors) if floors else None
    if args.format == "json":
        return (
            json.dumps(
                {
                    "schema": SCHEMA,
                    "command": "risk",
                    "file": RULES_REL,
                    "rules": rules,
                    "notes": notes,
                    "paths": paths,
                    "floor": floor,
                },
                indent=2,
                sort_keys=True,
            )
            + "\n"
        )
    out = []
    for entry in rules:
        if entry["state"] == "absent":
            out.append("No project review rules at %s (%s)." % (RULES_REL, entry["rules"]))
        elif entry["state"] == "collision":
            out.append("Collision: " + entry["message"])
        else:
            out.append("Project review rules: %s (%s)." % (RULES_REL, entry["rules"]))
            out += ["Warning: " + problem for problem in entry["problems"]]
    out += ["Note: " + note for note in notes]
    if not loaded:
        out.append("No tier or Risk floor comes from project review rules.")
        return "\n".join(out) + "\n"

    def source(s):
        return "%s %s" % (s["rules"], s["entry"]) if s["entry"] else "%s unlisted" % s["rules"]

    for p in paths:
        high = ", ".join("%s %s" % (s["rules"], s["glob"]) for s in p["always_high_sources"]) or "no"
        out.append(
            "%s: tier %d (%s); always_high: %s; Risk floor: %s"
            % (p["path"], p["tier"], "; ".join(source(s) for s in p["tier_sources"]), high, p["floor"] or "none")
        )
    out.append("Risk floor: %s" % (floor or "none"))
    return "\n".join(out) + "\n"


# --------------------------------------------------------------------------
# Finding fingerprints


PROTECTED_VALUES = ("no", "unsure", "security", "migration", "idempotency", "concurrency")
FINGERPRINT_RE = re.compile(r"([^\s#`]+)#(.+):([a-z-]+)")
LENS_RE = re.compile(r"[a-z][a-z0-9-]*")
REVIEWER_ID_RE = re.compile(r"\s*\(([A-Za-z]+[0-9]+)\)\s*$")


def label_value(found, label):
    value = found.get(label)
    return (value[0].strip().rstrip(".").strip(), value[1]) if value else (None, None)


def parse_fingerprints(value):
    """([fingerprint text], problem). Backticked fingerprints, comma-separated when verifiers differ; text outside
    the backticks is a note. Without backticks the first word is the fingerprint."""
    if not value.strip():
        return [], "is empty"
    parts = re.findall(r"`([^`]+)`", value) or [value.split()[0].rstrip(",;")]
    out = []
    for part in parts:
        match = FINGERPRINT_RE.fullmatch(part.strip())
        if not match or not match.group(2).strip():
            return [], "%r is not <path>#<symbol>:<rule class>" % part
        if match.group(3) not in RULE_CLASSES:
            return [], "%r has rule class %r; expected one of %s" % (part, match.group(3), ", ".join(RULE_CLASSES))
        out.append(part.strip())
    return out, None


def parse_protected(value):
    """([values], problem). One value, or one per verifier comma-separated; a parenthesis or a " - " note is allowed."""
    head = re.sub(r"\([^)]*\)", "", re.split(r"\s+-\s+", value, maxsplit=1)[0])
    words = [first_word(piece) for piece in head.split(",") if piece.strip()]
    bad = [w or piece.strip() for w, piece in zip(words, head.split(",")) if w not in PROTECTED_VALUES]
    if not words or bad:
        # Keep the values that did parse, so a recognised "security" survives a malformed neighbour.
        return (
            [w for w in words if w in PROTECTED_VALUES],
            "%r is not %s (one per verifier, comma-separated)" % (value, ", ".join(PROTECTED_VALUES)),
        )
    return words, None


def parse_lens(value):
    word = value.split()[0].strip("`.,;") if value.split() else ""
    return (word, None) if LENS_RE.fullmatch(word) else (None, "%r is not a lens name" % value)


def finding_metadata_problems(rid, found, number):
    """Format problems in a finding's Lens, Fingerprint and Protected fields. A record with none of the three
    (written before they existed) is not reported; one with only some of them is."""
    present = [label for label in ("lens", "fingerprint", "protected") if label in found]
    problems = []
    if present and len(present) < 3:
        missing = [label.capitalize() for label in ("lens", "fingerprint", "protected") if label not in found]
        problems.append(
            (
                "finding-metadata",
                "%s has %s but no %s" % (rid, ", ".join(label.capitalize() for label in present), ", ".join(missing)),
                number,
            )
        )
    for label, parse in (("lens", parse_lens), ("fingerprint", parse_fingerprints), ("protected", parse_protected)):
        value, line = label_value(found, label)
        if value is None:
            continue
        _, problem = parse(value)
        if problem:
            problems.append(("finding-" + label, "%s %s %s" % (rid, label.capitalize(), problem), line))
    return problems


def finding_outcome(verified, disposition):
    if disposition == "open" or disposition not in DISPOSITIONS:
        return "open"
    if verified == "refuted" or disposition == "accepted":
        return "rejected"
    return "fixed"


def item_findings(item):
    """Each R- record in the item's REVIEW.md, with what the repeat filter needs."""
    text = read_text(item, "REVIEW.md") if os.path.isfile(os.path.join(item.path, "REVIEW.md")) else None
    return findings_in_text(text) if text is not None else []


def findings_in_text(text):
    """Each R- record in a REVIEW.md text."""
    heads = {n: line for n, line, _ in markdown_lines(text)}
    out = []
    for rid, number, lines in record_sections(text, "R"):
        found = labels_in(lines)
        head = HEADING_RE.match(heads[number])
        assert head is not None  # record_sections starts every record at a heading
        heading = head.group(2).replace("**", "").strip()
        reviewer = REVIEWER_ID_RE.search(heading)
        title = re.sub(r"^%s\b\s*[-:]?\s*" % re.escape(rid), "", REVIEWER_ID_RE.sub("", heading)).strip()
        values = {
            label: label_value(found, label)[0]
            for label in (
                "severity",
                "evidence",
                "lens",
                "fingerprint",
                "protected",
                "verified",
                "disposition",
                "resolution",
            )
        }
        disposition = first_word(values["disposition"] or "")
        verified = first_word(values["verified"] or "")
        parsers = (("fingerprint", parse_fingerprints), ("protected", parse_protected), ("lens", parse_lens))
        parsed: dict[str, tuple[object, object]] = {
            label: parse(values[label]) for label, parse in parsers if values[label]
        }
        # A record written before these fields existed has none of them and is exempt; one that has any must have all,
        # so an empty or missing field among them cannot drop a classification.
        if any(label in found for label, _ in parsers):
            for label, _ in parsers:
                if not values[label]:
                    parsed[label] = ([] if label != "lens" else None, "is empty or missing")
        fingerprints = parsed["fingerprint"][0] if "fingerprint" in parsed else []
        protected = parsed["protected"][0] if "protected" in parsed else []
        lens = parsed["lens"][0] if "lens" in parsed else None
        unreadable = sorted(label.capitalize() for label, (_, problem) in parsed.items() if problem)
        outcome = finding_outcome(verified, disposition)
        reason = values["resolution"] or re.sub(r"^\w+\s*[-:]?\s*", "", values["disposition"] or "")
        out.append(
            {
                "id": rid,
                "reviewer_id": reviewer.group(1) if reviewer else None,
                "title": title,
                "line": number,
                "severity": first_word(values["severity"] or "") or None,
                "lens": lens,
                "fingerprints": fingerprints,
                "protected": protected,
                "unreadable": unreadable,
                "verified": verified or None,
                "disposition": disposition or None,
                "outcome": outcome,
                "problem": ". ".join(p for p in (title, values["evidence"]) if p),
                "reason": reason if outcome == "rejected" else None,
            }
        )
    return out


def cmd_fingerprints(item, fmt):
    findings = item_findings(item)
    if fmt == "json":
        return (
            json.dumps(
                {
                    "schema": SCHEMA,
                    "command": "fingerprints",
                    "item": item.path,
                    "file": os.path.join(item.path, "REVIEW.md"),
                    "findings": findings,
                },
                indent=2,
                sort_keys=True,
            )
            + "\n"
        )
    out = []
    for f in findings:
        out.append(
            "%s%s  %s  protected: %s  %s  %s"
            % (
                f["id"],
                " (%s)" % f["reviewer_id"] if f["reviewer_id"] else "",
                ", ".join(f["fingerprints"]) or "no fingerprint",
                ", ".join(f["protected"]) or "-",
                f["outcome"],
                f["title"],
            )
        )
    return "\n".join(out or ["No findings in %s." % os.path.join(item.path, "REVIEW.md")]) + "\n"


# --------------------------------------------------------------------------
# Security gate


SECURITY_CLASSES = ("auth", "injection", "secrets", "data-exposure")
GATE_LINE_RE = re.compile(r"^\s*(?:[-*+]\s+|#{1,6}\s+)?security gate\s*:\s*applies\b", re.IGNORECASE)
NOT_ACCEPT_RE = re.compile(
    r"\bnot(?:\s+\w+){0,2}\s+accept|\bpending\b|\bdeclin|\bwithdr(?:aw|ew|awn)\b|\breject", re.IGNORECASE
)
# A finding is released only in one canonical form, written by the agent; anything else stays open. Strict on
# purpose - a false block costs a rewrite, a false release ships a security defect.
FIX_VERIFIED_RE = re.compile(r"\s*fix\s+verified\s+by\s+a\s+fresh\s+verifier\b", re.IGNORECASE)
FIX_QUALIFIED_RE = re.compile(
    r"\b(?:not|never|yet|pending|awaiting|await|once|until|unless|failed|fails|refuted|refutes|disputed"
    r"|unverifiable|unconfirmed|unverified|partly|partially|still|remains?|cannot|exploit\w*|reproduc(?:es|ed|ible)"
    r"|bypass\w*)\b|n['\u2019]t\b",
    re.IGNORECASE,
)
FIX_REVISION_RE = re.compile(r"\b[0-9a-f]{7,40}\b")
FIX_CITATION_RE = re.compile(r"research/verification/[^\s()\[\]]+\.json")
# Anchored at the start of the user's quote, so a question such as "Should I accept R-01?" never matches.
ACCEPT_NAMED_RE = r"^\s*(?:I\s+)?accept(?:s|ed)?\s+(?:(?:security\s+)?finding\s+)?%s(?!\d)"
ACCEPT_QUALIFIED_RE = re.compile(
    r"\b(?:not|no|cannot|never|refuse\w*|reject\w*|(?:re)?open\w*|unresolved|unless|until|if)\b|n['\u2019]t\b",
    re.IGNORECASE,
)
QUOTE_RE = re.compile(r'"([^"]+)"|\u201c([^\u201d]+)\u201d')
AGENT_RE = re.compile(
    r"\b(?:agent|assistant|claude|codex|pi|implementer|orchestrator|reviewer|verifier)\b", re.IGNORECASE
)
AGENT_DECIDED_RE = re.compile(
    r"\b(?:the\s+)?agent\s+(?:accept|settl|decid|judg)|\bby\s+the\s+agent\b" r"|\bown\s+judge?ment\b", re.IGNORECASE
)


def security_gated(review_text):
    """Whether REVIEW.md records "Security gate: applies". Once recorded the gate stays on, so any such line counts,
    whatever a later line says."""
    return any(
        GATE_LINE_RE.match(line.replace("**", "")) for _, line, code in markdown_lines(review_text or "") if not code
    )


def security_kinds(finding):
    """Why a finding is security in kind: the security lens, a security rule class or `Protected: security` from any
    verifier, whichever lens raised it."""
    kinds = []
    if finding["lens"] == "security":
        kinds.append("lens security")
    matched = (FINGERPRINT_RE.fullmatch(f) for f in finding["fingerprints"])
    classes = sorted({m.group(3) for m in matched if m} & set(SECURITY_CLASSES))
    kinds += ["class %s" % c for c in classes]
    if "security" in finding["protected"]:
        kinds.append("Protected: security")
    if finding.get("unreadable"):
        # A field the gate cannot read might have said security; fail closed rather than drop the finding.
        kinds.append("unreadable %s" % ", ".join(finding["unreadable"]))
    return kinds


def verifier_confirms(path, ids, revision):
    """Whether a saved verifier reply confirms the fix of one of `ids` on `revision` (either may be the shorter)."""
    try:
        with open(path, encoding="utf-8") as fh:
            reply = json.load(fh)
    except (OSError, ValueError):
        return False
    if not isinstance(reply, dict):
        return False
    rev = str(reply.get("revision") or "").lower()
    return (
        reply.get("result") == "confirmed"
        and str(reply.get("id") or "") in ids
        and len(rev) >= 7
        and (rev.startswith(revision) or revision.startswith(rev))
    )


def fix_confirmed(resolution, item_path=None, ids=()):
    """Whether a Resolution ends with a sentence that begins "Fix verified by a fresh verifier", states it rather than
    asks it, does not qualify it, and names the fixed revision and the verifier's saved reply - a file that exists in
    the item when `item_path` is given, and whose reply confirms the fix of one of `ids` (the finding's R- ID) on that
    revision. Only the last sentence counts, so no later sentence can take it back."""
    sentences = [s for s in re.split(r"(?<=[.!?])\s+", (resolution or "").strip()) if s.strip()]
    last = sentences[-1] if sentences else ""
    if not (FIX_VERIFIED_RE.match(last) and not FIX_QUALIFIED_RE.search(last) and not last.rstrip().endswith("?")):
        return False
    cited = FIX_CITATION_RE.findall(last)
    revision = FIX_REVISION_RE.search(FIX_CITATION_RE.sub("", last))
    if not revision or not cited:
        return False
    if item_path is None:
        return True
    paths = [os.path.normpath(os.path.join(item_path, path)) for path in cited]
    # A citation must stay inside the item's research/verification/, so "../" cannot point at a reply elsewhere.
    inside = os.path.join(os.path.normpath(item_path), "research", "verification") + os.sep
    if not all(path.startswith(inside) for path in paths):
        return False
    return all(os.path.isfile(path) for path in paths) and any(
        verifier_confirms(path, set(ids), revision.group(0).lower()) for path in paths
    )


def user_quotes(bullet):
    """The quoted statements a DECISIONS.md bullet attributes to a person who is not an agent: `(Sam: "...")` or a
    quote the bullet closes with ` - Sam`."""
    out = []
    for m in QUOTE_RE.finditer(bullet):
        speaker = re.search(r"([A-Za-z][\w.' -]{0,40}?)\s*:\s*$", bullet[: m.start()])
        if not speaker:
            speaker = re.match(r"\s*\)?\s*[-\u2013]\s+([A-Za-z][\w.' -]{0,40}?)\s*\.?\s*$", bullet[m.end() :])
        if speaker and not AGENT_RE.search(speaker.group(1)):
            out.append(m.group(1) or m.group(2))
    return out


def user_acceptance_named(decisions_text, rid):
    """The user's own words, quoted on a DECISIONS.md bullet, say "accept <R- ID>" with no negation or open-state word.
    A bullet that says the agent decided, or an acceptance that names the package rather than the finding, does not
    count."""
    named = re.compile(ACCEPT_NAMED_RE % re.escape(rid), re.IGNORECASE)
    for bullet in decision_bullets(decisions_text or ""):
        if AGENT_DECIDED_RE.search(bullet) or NOT_ACCEPT_RE.search(bullet):
            continue
        if any(named.search(q) and "?" not in q and not ACCEPT_QUALIFIED_RE.search(q) for q in user_quotes(bullet)):
            return True
    return False


def open_security_findings(item):
    """[(finding, kinds, why it is still open)] for the security findings of the item's REVIEW.md that are not
    released. A refuted finding is never open; a resolved one is released only by the canonical "Fix verified by a
    fresh verifier" sentence in its Resolution; an accepted one only by the user's quoted "I accept <R- ID>" in
    DECISIONS.md."""
    review = item.docs.get("REVIEW.md")
    if review is None:
        return []
    earlier = security_in_history(item)
    resolutions = {}
    for rid, _, lines in record_sections(review, "R"):
        resolutions[rid] = label_value(labels_in(lines), "resolution")[0] or ""
    out = []
    current = item_findings(item)
    for finding in current:
        kinds = security_kinds(finding) or (["security in an earlier commit"] if finding["id"] in earlier else [])
        if not kinds or finding["verified"] == "refuted":
            continue
        disposition, rid = finding["disposition"], finding["id"]
        if disposition == "resolved":
            # Only the R- ID is unique in the item; reviewer IDs such as F1 recur across reviews.
            if fix_confirmed(resolutions.get(rid, ""), item.path, [rid]):
                continue
            why = (
                'resolved, but its Resolution does not end with "Fix verified by a fresh verifier on <revision>" '
                "citing a saved reply that confirms this finding's fix on that revision"
            )
        elif disposition == "accepted":
            if user_acceptance_named(item.docs.get("DECISIONS.md"), rid):
                continue
            why = (
                'accepted, but no DECISIONS.md entry quotes the user saying "I accept %s" without a negation '
                "or open-state word" % rid
            )
        else:
            why = "open"
        out.append((finding, kinds, why))
    present = {finding["id"] for finding in current}
    for rid, finding in sorted(earlier.items()):
        if rid not in present and finding["verified"] != "refuted":
            out.append((dict(finding, line=1), ["security in an earlier commit"], "removed from REVIEW.md"))
    return out


def review_history(item):
    """The text of every committed version of the item's REVIEW.md, following moves; [] outside Git. Cached."""
    if getattr(item, "_review_history", None) is not None:
        return item._review_history
    texts = []

    def git(*args):
        return subprocess.run(["git", "-C", item.path, *args], capture_output=True, text=True, check=False, timeout=30)

    try:
        log = git("log", "--follow", "--format=%x00%H", "--name-only", "--", "REVIEW.md")
        for entry in log.stdout.split("\0")[1:] if log.returncode == 0 else []:
            lines = [line for line in entry.splitlines() if line.strip()]
            if len(lines) < 2:
                continue
            shown = git("show", "%s:%s" % (lines[0], lines[1]))
            if shown.returncode == 0:
                texts.append(shown.stdout)
    except (OSError, subprocess.TimeoutExpired):
        texts = []
    item._review_history = texts
    return texts


def gate_in_history(item):
    """Whether any committed version of the item's REVIEW.md records the gate line as security_gated reads it."""
    return any(security_gated(text) for text in review_history(item))


def security_in_history(item):
    """{R- ID: title} of every finding that was security in kind in any committed version of REVIEW.md. The kind is
    sticky like the gate: stripping or relabelling a record's fields, or deleting the record, does not clear it."""
    out = {}
    for text in review_history(item):
        for finding in findings_in_text(text):
            if security_kinds(finding):
                out.setdefault(finding["id"], finding)
    return out


def validate_security_gate(item):
    review = item.docs.get("REVIEW.md")
    gated = security_gated(review)
    if not gated and gate_in_history(item):
        # The gate is sticky: a line removed or reworded, or REVIEW.md deleted, does not turn it off.
        gated = True
        item.diagnostics.append(
            diag(
                "security-gate-removed",
                "error",
                os.path.join(item.path, "REVIEW.md"),
                'an earlier commit of REVIEW.md records "Security gate: applies", but %s; '
                "the gate stays on - restore it" % ("the line is gone" if review is not None else "REVIEW.md is gone"),
                1,
            )
        )
    found = open_security_findings(item) if gated else []
    item.counts["security_gate"] = {"gated": gated, "open": [f["id"] for f, _, _ in found]}
    if not found:
        return
    path = os.path.join(item.path, "REVIEW.md")
    final = item.docs.get("FINAL.md")
    closing = [
        what
        for what, on in (
            ("FINAL.md exists", final is not None and not has_superseded_notice(final)),
            ("stage is complete", item.meta.get("stage") == "complete"),
            ("delivery is verified", item.meta.get("delivery") == "verified"),
        )
        if on
    ]
    for finding, kinds, why in found:
        rid = finding["id"]
        if why != "open":
            item.diagnostics.append(
                diag(
                    "security-release",
                    "warning",
                    path,
                    "%s (%s) is %s; it still blocks close-out" % (rid, ", ".join(kinds), why),
                    finding["line"],
                )
            )
        if closing:
            item.diagnostics.append(
                diag(
                    "security-gate-open",
                    "error",
                    path,
                    "the security gate applies and %s is an open security finding (%s), but %s; close-out waits for a "
                    "fix a fresh verifier confirms or the user's acceptance in DECISIONS.md naming %s"
                    % (rid, ", ".join(kinds), " and ".join(closing), rid),
                    finding["line"],
                )
            )


# --------------------------------------------------------------------------
# Command line


def default_root():
    try:
        top = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False
        ).stdout.strip()
    except OSError:
        top = ""
    return top or os.getcwd()


def select(items, refs):
    chosen = []
    for ref in refs:
        path = os.path.abspath(ref)
        if os.path.basename(path) == "IDEA.md":
            path = os.path.dirname(path)
        matches = (
            [i for i in items if i.path == path or os.path.realpath(i.path) == os.path.realpath(path)]
            if os.path.exists(path)
            else []
        )
        if not matches:
            matches = [i for i in items if ref in (i.folder, i.slug)]
        if not matches:
            raise UsageError("no item matches %r" % ref)
        if len(matches) > 1:
            raise UsageError("%r matches several items:\n  %s" % (ref, "\n  ".join(i.path for i in matches)))
        if matches[0] not in chosen:
            chosen.append(matches[0])
    return chosen


def parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--root", help="directory to search (default: current Git working tree)")
    common.add_argument("--all", action="store_true", help="include completed and cancelled items")
    common.add_argument("--format", choices=("text", "md", "json"), default="text")
    common.add_argument(
        "--exclude", action="append", default=[], metavar="GLOB", help="skip directories matching GLOB (repeatable)"
    )
    top = argparse.ArgumentParser(prog="gsd", description="Inventory, validate and safely update GSD work items.")
    sub = top.add_subparsers(dest="command")
    for name, text in (
        ("status", "one row per item (default)"),
        ("attention", "items needing attention"),
        ("next", "next actions, approvals and blocked items"),
        ("progress", "stage and record counts"),
        ("legacy", "legacy migration candidates"),
    ):
        sub.add_parser(name, parents=[common], help=text)
    validate = sub.add_parser("validate", parents=[common], help="report diagnostics")
    validate.add_argument("items", nargs="*", metavar="ITEM", help="slug, item folder or IDEA.md path")
    validate.add_argument("--strict", action="store_true", help="fail on warnings too")

    owner = sub.add_parser("owner", parents=[common], help="show or change the owning checkout")
    owner.add_argument("action", choices=("show", "set", "unset"))
    owner.add_argument("checkout", nargs="?", help="owning checkout for set (default: this checkout)")
    owner.add_argument("--item", help="map one item slug rather than the whole repository")
    owner.add_argument("--every", action="store_true", help="show entries for every repository")

    new = sub.add_parser("new", parents=[common], help="create IDEA.md for a new item")
    new.add_argument("title")
    new.add_argument("--slug", help="folder name without the date (default: from the branch or title)")
    new.add_argument("--type", choices=TYPES, default="feature")
    new.add_argument("--purpose")
    new.add_argument("--next-action", dest="next_action")
    new.add_argument("--responsible", choices=RESPONSIBLE, default="agent")

    setp = sub.add_parser("set", parents=[common], help="change IDEA.md front-matter fields")
    setp.add_argument("item", metavar="ITEM")
    setp.add_argument("pairs", nargs="+", metavar="KEY=VALUE")
    setp.add_argument("--expect", metavar="SHA256", help="refuse unless IDEA.md has this digest")

    plan = sub.add_parser("plan", parents=[common], help="write planning records only")
    plan.add_argument("item", metavar="ITEM")
    plan.add_argument("--write", metavar="DOC", help="replace PLAN.md, SPEC.md, TODO.md or DECISIONS.md from stdin")
    plan.add_argument("--set", action="append", metavar="KEY=VALUE", help="next_action, responsible or stage")
    plan.add_argument("--expect", metavar="SHA256", help="refuse unless the target has this digest")

    prune = sub.add_parser("prune", parents=[common], help="move complete and cancelled items to docs/gsd/YYYY/MM/")
    prune.add_argument("items", nargs="*", metavar="ITEM")
    prune.add_argument("--dry", action="store_true", help="preview only")

    compact = sub.add_parser(
        "compact", parents=[common], help="replace a closed item's folder with its committed docs/gsd summary"
    )
    compact.add_argument("item", metavar="ITEM")
    compact.add_argument("--dry", action="store_true", help="preview only")

    fold = sub.add_parser(
        "fold",
        parents=[common],
        help="remove a closed item's folder, leaving nothing in docs/gsd; Git keeps the record",
    )
    fold.add_argument("item", metavar="ITEM")
    fold.add_argument(
        "--record", required=True, metavar="SHA", help="full SHA of the commit that holds the item folder as it is now"
    )
    fold.add_argument("--dry", action="store_true", help="preview only")

    reopen = sub.add_parser("reopen", parents=[common], help="reopen a complete or cancelled item")
    reopen.add_argument("item", metavar="ITEM")
    reopen.add_argument("--stage", choices=STAGES[:-1])
    reopen.add_argument("--delivery", choices=DELIVERIES[:-2])
    reopen.add_argument("--reason")
    reopen.add_argument("--dry", action="store_true", help="preview only")

    comments = sub.add_parser("comments", parents=[common], help="list human comments or assign their IDs")
    comments.add_argument("items", nargs="*", metavar="ITEM")
    comments.add_argument("--assign", action="store_true", help="add markers for unassigned comments")

    agents = sub.add_parser("agents", help="resolve stage agents from the skill, user and repo layers")
    agents.add_argument("stage", nargs="?", metavar="STAGE", help=", ".join(AGENT_STAGES))
    agents.add_argument("name", nargs="?", metavar="NAME", help="agent whose composed brief --body prints")
    agents.add_argument("--all", action="store_true", help="every stage")
    agents.add_argument("--body", action="store_true", help="print one agent's composed brief")
    agents.add_argument("--root", help="repository root (default: current Git working tree)")
    agents.add_argument("--format", choices=("text", "md", "json"), default="text")

    fingerprints = sub.add_parser(
        "fingerprints",
        parents=[common],
        help="list the findings in an item's REVIEW.md for the packet's known-findings.json",
    )
    fingerprints.add_argument("item", metavar="ITEM")

    risk = sub.add_parser("risk", help="tier, always_high match and Risk floor per path from the project review rules")
    risk.add_argument("paths", nargs="*", metavar="PATH", help="path relative to the repository root")
    risk.add_argument("--base", metavar="REV", help="also read the rules at REV and take the higher tier")
    risk.add_argument(
        "--changed",
        action="store_true",
        help="also check every path changed from --base to HEAD, both sides of a rename",
    )
    risk.add_argument("--root", help="repository root (default: current Git working tree)")
    risk.add_argument("--format", choices=("text", "json"), default="text")
    return top, common


COMMANDS = {
    "status",
    "attention",
    "next",
    "progress",
    "legacy",
    "validate",
    "owner",
    "new",
    "set",
    "plan",
    "prune",
    "compact",
    "fold",
    "reopen",
    "comments",
    "agents",
    "risk",
    "fingerprints",
}


def render_moves(command, results, fmt):
    if fmt == "json":
        return json.dumps({"schema": SCHEMA, "command": command, "results": results}, indent=2, sort_keys=True) + "\n"
    out = []
    for r in results:
        if "skipped" in r:
            out.append("skip %s: %s" % (r["path"], r["skipped"]))
            continue
        if r.get("folded"):
            out.append("remove %s (folded; nothing left in docs/gsd)" % r["from"])
        elif r.get("compacted"):
            out.append("remove %s (summary %s)" % (r["from"], r["to"]))
        else:
            out.append("move %s -> %s" % (r["from"], r["to"]) if r["from"] != r["to"] else "update %s" % r["from"])
        out += ["  rebase links in %s" % p for p in r.get("rewrites", [])]
        if r.get("lifecycle_unticked"):
            out.append("  untick Lifecycle stages: " + ", ".join(r["lifecycle_unticked"]))
        if r.get("trailer"):
            out.append("  commit trailer: " + r["trailer"])
    return "\n".join(out or ["Nothing to do."]) + "\n"


def render_comments(items, fmt):
    rows = [dict(c, item=i.slug) for i in items for c in i.comments]
    if fmt == "json":
        return json.dumps({"schema": SCHEMA, "command": "comments", "comments": rows}, indent=2, sort_keys=True) + "\n"
    if fmt == "md":
        return (
            "\n".join(
                md_table(
                    ["Item", "ID", "Status", "Where", "Text"],
                    [
                        [
                            c["item"],
                            c["id"] or "",
                            c["status"],
                            "%s:%d" % (c["file"], c["line"]),
                            c["text"].splitlines()[0],
                        ]
                        for c in rows
                    ],
                )
                or []
            )
            + "\n"
        )
    out = [
        "%s  %s  %s  %s:%d  %s"
        % (c["item"], c["id"] or "-", c["status"], c["file"], c["line"], c["text"].splitlines()[0])
        for c in rows
    ]
    return "\n".join(out or ["No comments."]) + "\n"


def one(items, ref):
    return select(items, [ref])[0]


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    top, common = parser()
    if not argv or (argv[0] not in COMMANDS and argv[0] not in ("-h", "--help")):
        argv = ["status"] + argv
    try:
        args = top.parse_args(argv)
    except SystemExit as exit_:
        return 0 if exit_.code == 0 else 2
    root = os.path.abspath(os.path.expanduser(args.root)) if args.root else default_root()
    if not os.path.isdir(root):
        print("gsd: root %s is not a directory" % root, file=sys.stderr)
        return 2
    command = args.command
    try:
        if command == "owner":
            if args.action == "show":
                entries, identity = cmd_owner(args, root)
                entries = cast("list[dict[str, str]]", entries)
                if args.format == "json":
                    sys.stdout.write(
                        json.dumps(
                            {
                                "schema": SCHEMA,
                                "command": "owner",
                                "repo": identity,
                                "file": owners_path(),
                                "owners": entries,
                            },
                            indent=2,
                            sort_keys=True,
                        )
                        + "\n"
                    )
                else:
                    sys.stdout.write("repo %s\nfile %s\n" % (identity, owners_path()))
                    for e in entries:
                        sys.stdout.write(
                            "%s%s -> %s\n" % (e["repo"], (" [%s]" % e["slug"]) if e.get("slug") else "", e["checkout"])
                        )
                return 0
            paths, _ = cmd_owner(args, root)
            sys.stdout.write(written("owner", paths, args.format))
            return 0
        if command == "new":
            sys.stdout.write(written("new", cmd_new(args, root), args.format))
            return 0
        if command == "agents":
            text, failed = cmd_agents(args, root)
            sys.stdout.write(text)
            return 1 if failed else 0
        if command == "risk":
            sys.stdout.write(cmd_risk(args, root))
            return 0
        git_checks = command in ("validate", "attention", "progress")
        items, legacy, scan = build(root, args.exclude, git_checks)
        if command == "validate":
            chosen = select(items, args.items) if args.items else items
            checkouts = sorted({root} | {i.checkout for i in chosen})
            rules = [d for checkout in checkouts for d in validate_rules(checkout)]
            text, failed = render_validate(
                root, chosen, (scan if not args.items else []) + rules, args.format, args.strict
            )
            sys.stdout.write(text)
            return 1 if failed else 0
        if command == "set":
            item = one(items, args.item)
            sys.stdout.write(
                written("set", apply_idea_changes(item, parse_assignments(args.pairs), args.expect), args.format)
            )
            return 0
        if command == "plan":
            sys.stdout.write(written("plan", cmd_plan(args, one(items, args.item)), args.format))
            return 0
        if command == "fingerprints":
            if args.format == "md":
                raise UsageError("fingerprints prints text or json")
            sys.stdout.write(cmd_fingerprints(one(items, args.item), args.format))
            return 0
        if command == "prune":
            results = cmd_prune(items, args.items, args.dry)
            sys.stdout.write(render_moves("prune", results, args.format))
            return 0
        if command == "compact":
            result = cmd_compact(one(items, args.item), args.dry)
            sys.stdout.write(render_moves("compact", [result], args.format))
            return 0
        if command == "fold":
            result = cmd_fold(one(items, args.item), args.record, args.dry)
            sys.stdout.write(render_moves("fold", [result], args.format))
            return 0
        if command == "reopen":
            result = cmd_reopen(one(items, args.item), args)
            sys.stdout.write(render_moves("reopen", [result], args.format))
            return 0
        if command == "comments":
            chosen = select(items, args.items) if args.items else visible(items, args.all)
            if args.assign:
                if len(chosen) != 1 or not args.items:
                    raise UsageError("comments --assign needs exactly one ITEM")
                sys.stdout.write(written("comments", cmd_comments_assign(chosen[0]), args.format))
                return 0
            sys.stdout.write(render_comments(chosen, args.format))
            return 0
    except UsageError as error:
        print("gsd: %s" % error, file=sys.stderr)
        return 2
    except Refused as error:
        print("gsd: refused: %s" % error, file=sys.stderr)
        return 1
    except Conflict as error:
        print("gsd: conflict: %s" % error, file=sys.stderr)
        return 3
    except OSError as error:
        print("gsd: conflict: %s" % error, file=sys.stderr)
        return 3
    shown = visible(items, args.all, command)
    sys.stdout.write(render(command, root, shown, legacy, scan, args.format))
    return 0


if __name__ == "__main__":
    sys.exit(main())
